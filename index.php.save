<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Timetable — Gestion de l'emploi du temps</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --navy:   #0a1628;
            --blue:   #1a3a6e;
            --accent: #e8a838;
            --gold:   #f5c842;
            --light:  #f0ece4;
            --white:  #ffffff;
        }

        html, body {
            height: 100%;
            font-family: 'DM Sans', sans-serif;
            background: var(--navy);
            color: var(--white);
            overflow-x: hidden;
        }

        /* ── Background ── */
        .bg {
            position: fixed; inset: 0; z-index: 0;
            background: radial-gradient(ellipse 80% 60% at 20% 10%, #1a3a6e55 0%, transparent 60%),
                        radial-gradient(ellipse 60% 50% at 80% 80%, #e8a83818 0%, transparent 55%),
                        var(--navy);
        }
        .bg::before {
            content: '';
            position: absolute; inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 30%, transparent 100%);
        }

        /* ── Layout ── */
        .page {
            position: relative; z-index: 1;
            min-height: 100vh;
            display: flex; flex-direction: column;
        }

        /* ── Header ── */
        header {
            padding: 2rem 4rem;
            display: flex; align-items: center; gap: 1rem;
            opacity: 0; animation: fadeDown .7s .1s ease forwards;
        }
        .logo-icon {
            width: 42px; height: 42px;
            background: var(--accent);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
        }
        .logo-icon svg { color: var(--navy); }
        .logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem; font-weight: 700;
            letter-spacing: .5px;
        }
        .logo-text span { color: var(--accent); }

        /* ── Hero ── */
        .hero {
            flex: 1;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            text-align: center;
            padding: 4rem 2rem 6rem;
            gap: 2rem;
        }

        .badge {
            display: inline-flex; align-items: center; gap: .5rem;
            background: rgba(232,168,56,.12);
            border: 1px solid rgba(232,168,56,.3);
            color: var(--accent);
            font-size: .8rem; font-weight: 500; letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: .45rem 1.1rem;
            border-radius: 999px;
            opacity: 0; animation: fadeUp .6s .3s ease forwards;
        }
        .badge::before {
            content: '';
            width: 7px; height: 7px;
            background: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--accent);
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(3rem, 8vw, 6.5rem);
            font-weight: 900;
            line-height: 1.05;
            letter-spacing: -1px;
            max-width: 820px;
            opacity: 0; animation: fadeUp .7s .45s ease forwards;
        }
        h1 em {
            font-style: normal;
            color: var(--accent);
            position: relative;
        }
        h1 em::after {
            content: '';
            position: absolute;
            left: 0; bottom: -6px;
            width: 100%; height: 3px;
            background: linear-gradient(90deg, var(--accent), transparent);
            border-radius: 2px;
        }

        .subtitle {
            font-size: 1.1rem;
            color: rgba(255,255,255,.55);
            max-width: 480px;
            line-height: 1.7;
            font-weight: 300;
            opacity: 0; animation: fadeUp .7s .6s ease forwards;
        }

        /* ── CTA ── */
        .cta-group {
            display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;
            opacity: 0; animation: fadeUp .7s .75s ease forwards;
        }

        .btn-primary {
            display: inline-flex; align-items: center; gap: .6rem;
            background: var(--accent);
            color: var(--navy);
            font-family: 'DM Sans', sans-serif;
            font-size: 1rem; font-weight: 600;
            padding: .9rem 2.2rem;
            border-radius: 12px;
            text-decoration: none;
            border: none; cursor: pointer;
            transition: transform .2s, box-shadow .2s, background .2s;
            box-shadow: 0 8px 30px rgba(232,168,56,.3);
        }
        .btn-primary:hover {
            background: var(--gold);
            transform: translateY(-3px);
            box-shadow: 0 14px 40px rgba(232,168,56,.45);
        }
        .btn-primary:active { transform: translateY(0); }

        .btn-secondary {
            display: inline-flex; align-items: center; gap: .6rem;
            background: transparent;
            color: rgba(255,255,255,.7);
            font-family: 'DM Sans', sans-serif;
            font-size: 1rem; font-weight: 400;
            padding: .9rem 2.2rem;
            border-radius: 12px;
            text-decoration: none;
            border: 1px solid rgba(255,255,255,.15);
            cursor: pointer;
            transition: border-color .2s, color .2s, transform .2s;
        }
        .btn-secondary:hover {
            border-color: rgba(255,255,255,.4);
            color: var(--white);
            transform: translateY(-3px);
        }

        /* ── Stats ── */
        .stats {
            display: flex; gap: 3rem; flex-wrap: wrap; justify-content: center;
            opacity: 0; animation: fadeUp .7s .9s ease forwards;
        }
        .stat { text-align: center; }
        .stat-number {
            font-family: 'Playfair Display', serif;
            font-size: 2rem; font-weight: 700;
            color: var(--accent);
        }
        .stat-label {
            font-size: .8rem; color: rgba(255,255,255,.4);
            letter-spacing: 1px; text-transform: uppercase;
            margin-top: .2rem;
        }
        .stat-divider {
            width: 1px; background: rgba(255,255,255,.1);
            align-self: stretch;
        }

        /* ── Features strip ── */
        .features {
            display: flex; gap: 1px;
            background: rgba(255,255,255,.07);
            border-top: 1px solid rgba(255,255,255,.07);
            opacity: 0; animation: fadeUp .7s 1.05s ease forwards;
        }
        .feature {
            flex: 1; min-width: 200px;
            display: flex; align-items: center; gap: 1rem;
            padding: 1.8rem 2.5rem;
            background: rgba(10,22,40,.6);
            backdrop-filter: blur(12px);
            transition: background .2s;
        }
        .feature:hover { background: rgba(26,58,110,.35); }
        .feature-icon {
            width: 40px; height: 40px; flex-shrink: 0;
            background: rgba(232,168,56,.12);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: var(--accent);
        }
        .feature-text strong {
            display: block; font-size: .9rem; font-weight: 500;
            color: rgba(255,255,255,.9);
        }
        .feature-text span {
            font-size: .78rem; color: rgba(255,255,255,.4);
        }

        /* ── Floating calendar decoration ── */
        .deco-calendar {
            position: fixed;
            right: -80px; top: 50%;
            transform: translateY(-50%);
            width: 340px; height: 340px;
            border: 1px solid rgba(232,168,56,.1);
            border-radius: 24px;
            background: rgba(26,58,110,.15);
            backdrop-filter: blur(8px);
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px; padding: 20px;
            opacity: .25;
            pointer-events: none;
            z-index: 0;
            animation: float 6s ease-in-out infinite;
        }
        .deco-cell {
            aspect-ratio: 1;
            border-radius: 6px;
            background: rgba(255,255,255,.06);
        }
        .deco-cell.active { background: var(--accent); opacity: .7; }
        .deco-cell.mid { background: rgba(232,168,56,.25); }

        /* ── Animations ── */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(24px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeDown {
            from { opacity: 0; transform: translateY(-16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes float {
            0%, 100% { transform: translateY(-50%) rotate(-3deg); }
            50%       { transform: translateY(calc(-50% - 20px)) rotate(-3deg); }
        }

        @media (max-width: 700px) {
            header { padding: 1.5rem 1.5rem; }
            .feature { padding: 1.2rem 1.5rem; }
            .deco-calendar { display: none; }
            .stats { gap: 1.5rem; }
            .stat-divider { display: none; }
        }
    </style>
</head>
<body>

<div class="bg"></div>

<!-- Floating calendar decoration -->
<div class="deco-calendar" aria-hidden="true">
    <?php
    for($i = 0; $i < 35; $i++){
        $active = in_array($i, [8, 15, 22]);
        $mid    = in_array($i, [3, 10, 17, 24, 29]);
        $cls = $active ? 'active' : ($mid ? 'mid' : '');
        echo "<div class='deco-cell $cls'></div>";
    }
    ?>
</div>

